# Contact form delivery (server-side, /api/contact). Set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Without all three, the form tells visitors their message was NOT sent
# and shows hello@arkalegion.com instead (it never fakes success).
RESEND_API_KEY=
# Inbox that receives enquiries (comma-separated for several)
CONTACT_TO=
# Verified Resend sender, e.g. "ARKA Website <web@arkalegion.com>"
CONTACT_FROM=
